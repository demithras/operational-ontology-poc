# H13 query 4 — "Which policy and authorization model versions were
# evaluated?"
# Phase 9 step 0b: scoped to GRAPH <%%GRAPH_IRI%%> (see q1's header comment
# for the full rationale).
PREFIX oo: <https://example.local/oo/>
SELECT DISTINCT ?policyBundleVersion ?authorizationModelVersion ?policyInputHash ?checkRelation ?checkObject
WHERE {
  GRAPH <%%GRAPH_IRI%%> {
    ?decision oo:decisionId "%%DECISION_ID%%" ;
              oo:policyBundleVersion ?policyBundleVersion ;
              oo:authorizationModelVersion ?authorizationModelVersion .
    OPTIONAL { ?decision oo:policyEvaluation ?pe . ?pe oo:policyInputHash ?policyInputHash . }
    OPTIONAL { ?decision oo:authorizationCheck ?ac . ?ac oo:checkRelation ?checkRelation ; oo:checkObject ?checkObject . }
  }
}
