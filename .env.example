# Copy to .env for local docker-compose runs. Never commit the real .env.
# These are local-only POC credentials for a Docker Postgres instance with
# no external exposure beyond localhost — not production secrets.

# Postgres bootstrap superuser (used only by db/init/ scripts to create the
# per-system roles/databases below; application code never connects as this
# user).
POSTGRES_SUPERUSER=oo_admin
POSTGRES_SUPERUSER_PASSWORD=oo_admin_local_pw

# Host-mapped Postgres port (container always listens on 5432 internally).
POSTGRES_HOST_PORT=15432

# --- Per-system databases/roles (docs/experiment/spec/02: "must use
# separate databases/schemas, APIs, credentials ... so the ontology layer
# cannot cheat with cross-database SQL") ---
ERP_DB_NAME=erp
ERP_DB_USER=erp_role
ERP_DB_PASSWORD=erp_local_pw
ERP_HTTP_PORT=15401

MES_DB_NAME=mes
MES_DB_USER=mes_role
MES_DB_PASSWORD=mes_local_pw
MES_HTTP_PORT=15402

WMS_DB_NAME=wms
WMS_DB_USER=wms_role
WMS_DB_PASSWORD=wms_local_pw
WMS_HTTP_PORT=15403

# Created now, used starting Phase 3+ (semantic core) / Phase 8 (A/B baseline).
ONTOLOGY_HOT_DB_NAME=ontology_hot
ONTOLOGY_HOT_DB_USER=ontology_hot_role
ONTOLOGY_HOT_DB_PASSWORD=ontology_hot_local_pw

BASELINE_DB_NAME=baseline
BASELINE_DB_USER=baseline_role
BASELINE_DB_PASSWORD=baseline_local_pw

# Phase 7: OpenFGA's OWN database (postgres datastore engine, not `memory` --
# a container restart/recreation must never wipe the authorization store;
# see docs/adr/0004-openfga-historical-model-and-tuple-snapshot.md).
OPENFGA_DB_NAME=openfga
OPENFGA_DB_USER=openfga_role
OPENFGA_DB_PASSWORD=openfga_local_pw

# Test-mode fault-injection endpoints are only mounted when this is 1.
OO_TEST_MODE=1

# --- Phase 3: semantic core + CDC ingestion (docs/adr/0002-cdc-now-not-deferred.md) ---
# RDF4J server+workbench (repository REST API at $RDF4J_BASE_URL/repositories/oo).
RDF4J_HOST_PORT=15480
# Kafka broker (KRaft single node) — Debezium's durable event transport.
KAFKA_HOST_PORT=15492
# Debezium Connect REST API (register/inspect source connectors).
CONNECT_HOST_PORT=15483
# services/ingestion health/metrics endpoint (F38 DLQ visibility).
INGESTION_HEALTH_PORT=15484

# --- Phase 4: hot projections (docs/experiment/briefs/phase4.md) ---
# services/projection_builder health/metrics endpoint.
PROJECTION_BUILDER_HEALTH_PORT=15485
# Short-poll cadence (item 1: "triggered by ingestion updates or a short poll").
OO_PROJECTION_POLL_INTERVAL_S=3

# --- Phase 5: decision service + gates (docs/experiment/briefs/phase5.md) ---
# OpenFGA HTTP API (memory datastore — services/decision_service/bootstrap_openfga.py
# re-creates the store/model/tuples on every `make up`, since memory storage
# does not survive a container restart).
OPENFGA_HOST_PORT=15481
# OPA server HTTP API, loading contracts/policies/v1 as a mounted read-only
# bundle directory (no bootstrap step needed — see docker-compose.yml).
OPA_HOST_PORT=15482
# services/decision_service FastAPI app.
DECISION_SERVICE_HTTP_PORT=15410

# --- Phase 6: durable action runtime (docs/experiment/briefs/phase6.md) ---
# Temporal's own DEDICATED Postgres (never the shared oo-poc Postgres —
# db/init/00_init.sh only runs on first volume init, so adding a database to
# the shared instance would need a data-losing reset; a separate container
# needs no such migration and keeps Temporal's schema fully isolated).
TEMPORAL_POSTGRES_USER=temporal
TEMPORAL_POSTGRES_PASSWORD=temporal_local_pw
# Temporal frontend gRPC (temporalio Python SDK client + `tctl`/`temporal` CLI).
TEMPORAL_FRONTEND_HOST_PORT=15473
# Temporal Web UI (optional, human debugging only — nothing in this repo's
# tests depends on it being reachable).
TEMPORAL_UI_HOST_PORT=15474
# services/action_worker health endpoint.
ACTION_WORKER_HEALTH_PORT=15486
# services/reconciliation health endpoint.
RECONCILIATION_HEALTH_PORT=15487
