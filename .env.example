# Copy to .env for local docker-compose runs. Never commit the real .env.
# These are local-only POC credentials for a Docker Postgres instance with
# no external exposure beyond localhost — not production secrets.

# Postgres bootstrap superuser (used only by db/init/ scripts to create the
# per-system roles/databases below; application code never connects as this
# user).
POSTGRES_SUPERUSER=oo_admin
POSTGRES_SUPERUSER_PASSWORD=oo_admin_local_pw

# Host-mapped Postgres port (container always listens on 5432 internally).
POSTGRES_HOST_PORT=15432

# --- Per-system databases/roles (docs/experiment/spec/02: "must use
# separate databases/schemas, APIs, credentials ... so the ontology layer
# cannot cheat with cross-database SQL") ---
ERP_DB_NAME=erp
ERP_DB_USER=erp_role
ERP_DB_PASSWORD=erp_local_pw
ERP_HTTP_PORT=15401

MES_DB_NAME=mes
MES_DB_USER=mes_role
MES_DB_PASSWORD=mes_local_pw
MES_HTTP_PORT=15402

WMS_DB_NAME=wms
WMS_DB_USER=wms_role
WMS_DB_PASSWORD=wms_local_pw
WMS_HTTP_PORT=15403

# Created now, used starting Phase 3+ (semantic core) / Phase 8 (A/B baseline).
ONTOLOGY_HOT_DB_NAME=ontology_hot
ONTOLOGY_HOT_DB_USER=ontology_hot_role
ONTOLOGY_HOT_DB_PASSWORD=ontology_hot_local_pw

BASELINE_DB_NAME=baseline
BASELINE_DB_USER=baseline_role
BASELINE_DB_PASSWORD=baseline_local_pw

# Test-mode fault-injection endpoints are only mounted when this is 1.
OO_TEST_MODE=1

# --- Phase 3: semantic core + CDC ingestion (docs/adr/0002-cdc-now-not-deferred.md) ---
# RDF4J server+workbench (repository REST API at $RDF4J_BASE_URL/repositories/oo).
RDF4J_HOST_PORT=15480
# Kafka broker (KRaft single node) — Debezium's durable event transport.
KAFKA_HOST_PORT=15492
# Debezium Connect REST API (register/inspect source connectors).
CONNECT_HOST_PORT=15483
# services/ingestion health/metrics endpoint (F38 DLQ visibility).
INGESTION_HEALTH_PORT=15484
