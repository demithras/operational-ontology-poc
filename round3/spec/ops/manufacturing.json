 "operations": [
  {
   "approval": {
    "approver_operation": "approval:large_transfer",
    "required_when_rule": "transfer-large-needs-approval",
    "rules": [
     "approver is a principal different from the requester and outside the requester's delegation chain",
     "approval binds to the exact inputs that were pending; any change needs a fresh decision"
    ]
   },
   "business_rules": [
    {
     "decision": "deny",
     "description": "Deny when the source inventory lot for (part, source) is absent or ambiguous, or quantity is not an integer.",
     "id": "transfer-no-evidence",
     "when": {
      "args": [
       {
        "args": [
         {
          "args": [
           {
            "unique": {
             "type": "InventoryLot",
             "where": [
              {
               "link": "PartReferencing_part",
               "to": {
                "input": "part"
               }
              },
              {
               "link": "InventoryLot_warehouse",
               "to": {
                "input": "source_warehouse"
               }
              }
             ]
            }
           }
          ],
          "op": "exists"
         }
        ],
        "op": "not"
       },
       {
        "args": [
         {
          "args": [
           {
            "input": "quantity"
           }
          ],
          "op": "is_int"
         }
        ],
        "op": "not"
       }
      ],
      "op": "or"
     }
    },
    {
     "decision": "deny",
     "description": "Deny unless the newest EvidenceSnapshot exists and is at most evidence_max_age_ticks old.",
     "id": "transfer-stale-evidence",
     "when": {
      "args": [
       {
        "args": [
         {
          "sub": [
           {
            "now": true
           },
           {
            "newest": {
             "field": "snapshotObservedAt",
             "type": "EvidenceSnapshot"
            }
           }
          ]
         },
         {
          "lit": 6
         }
        ],
        "op": "lt"
       }
      ],
      "op": "not"
     }
    },
    {
     "decision": "deny",
     "description": "Deny when the source lot or the destination lot (if one exists) has qualityStatus QUARANTINE.",
     "id": "transfer-quarantine",
     "when": {
      "args": [
       {
        "args": [
         {
          "field": [
           {
            "unique": {
             "type": "InventoryLot",
             "where": [
              {
               "link": "PartReferencing_part",
               "to": {
                "input": "part"
               }
              },
              {
               "link": "InventoryLot_warehouse",
               "to": {
                "input": "source_warehouse"
               }
              }
             ]
            }
           },
           "qualityStatus"
          ]
         },
         {
          "lit": "QUARANTINE"
         }
        ],
        "op": "eq"
       },
       {
        "args": [
         {
          "args": [
           {
            "unique": {
             "type": "InventoryLot",
             "where": [
              {
               "link": "PartReferencing_part",
               "to": {
                "input": "part"
               }
              },
              {
               "link": "InventoryLot_warehouse",
               "to": {
                "input": "destination_warehouse"
               }
              }
             ]
            }
           }
          ],
          "op": "exists"
         },
         {
          "args": [
           {
            "field": [
             {
              "unique": {
               "type": "InventoryLot",
               "where": [
                {
                 "link": "PartReferencing_part",
                 "to": {
                  "input": "part"
                 }
                },
                {
                 "link": "InventoryLot_warehouse",
                 "to": {
                  "input": "destination_warehouse"
                 }
                }
               ]
              }
             },
             "qualityStatus"
            ]
           },
           {
            "lit": "QUARANTINE"
           }
          ],
          "op": "eq"
         }
        ],
        "op": "and"
       }
      ],
      "op": "or"
     }
    },
    {
     "decision": "deny",
     "description": "Deny when the source lot has onHand < reserved.",
     "id": "transfer-reservation-broken",
     "when": {
      "args": [
       {
        "field": [
         {
          "unique": {
           "type": "InventoryLot",
           "where": [
            {
             "link": "PartReferencing_part",
             "to": {
              "input": "part"
             }
            },
            {
             "link": "InventoryLot_warehouse",
             "to": {
              "input": "source_warehouse"
             }
            }
           ]
          }
         },
         "onHand"
        ]
       },
       {
        "field": [
         {
          "unique": {
           "type": "InventoryLot",
           "where": [
            {
             "link": "PartReferencing_part",
             "to": {
              "input": "part"
             }
            },
            {
             "link": "InventoryLot_warehouse",
             "to": {
              "input": "source_warehouse"
             }
            }
           ]
          }
         },
         "reserved"
        ]
       }
      ],
      "op": "lt"
     }
    },
    {
     "decision": "deny",
     "description": "Deny when onHand - reserved - quantity at the source would fall below the safety stock for (part, source).",
     "id": "transfer-safety-stock",
     "when": {
      "args": [
       {
        "sub": [
         {
          "sub": [
           {
            "field": [
             {
              "unique": {
               "type": "InventoryLot",
               "where": [
                {
                 "link": "PartReferencing_part",
                 "to": {
                  "input": "part"
                 }
                },
                {
                 "link": "InventoryLot_warehouse",
                 "to": {
                  "input": "source_warehouse"
                 }
                }
               ]
              }
             },
             "onHand"
            ]
           },
           {
            "field": [
             {
              "unique": {
               "type": "InventoryLot",
               "where": [
                {
                 "link": "PartReferencing_part",
                 "to": {
                  "input": "part"
                 }
                },
                {
                 "link": "InventoryLot_warehouse",
                 "to": {
                  "input": "source_warehouse"
                 }
                }
               ]
              }
             },
             "reserved"
            ]
           }
          ]
         },
         {
          "input": "quantity"
         }
        ]
       },
       {
        "args": {
         "part": {
          "input": "part"
         },
         "warehouse": {
          "input": "source_warehouse"
         }
        },
        "read": "safety_stock"
       }
      ],
      "op": "lt"
     }
    },
    {
     "decision": "deny",
     "description": "Deny when the route (part, source, destination) protects a HIGH-priority at-risk work order (read protecting_work_orders is non-empty) and the acting principal holds neither the planner nor the supervisor relation on the source warehouse.",
     "id": "transfer-protected-route",
     "when": {
      "args": [
       {
        "args": [
         {
          "args": {
           "destination": {
            "input": "destination_warehouse"
           },
           "part": {
            "input": "part"
           },
           "source": {
            "input": "source_warehouse"
           }
          },
          "read": "protecting_work_orders"
         },
         {
          "lit": []
         }
        ],
        "op": "ne"
       },
       {
        "args": [
         {
          "args": [
           {
            "on": {
             "input": "source_warehouse"
            },
            "op": "actor_holds",
            "relation": "planner"
           },
           {
            "on": {
             "input": "source_warehouse"
            },
            "op": "actor_holds",
            "relation": "supervisor"
           }
          ],
          "op": "or"
         }
        ],
        "op": "not"
       }
      ],
      "op": "and"
     }
    },
    {
     "decision": "require_approval",
     "description": "Quantity above approval_threshold_units needs approval (applies only when no deny rule matched).",
     "id": "transfer-large-needs-approval",
     "when": {
      "args": [
       {
        "input": "quantity"
       },
       {
        "lit": 80
       }
      ],
      "op": "gt"
     }
    }
   ],
   "effects": [
    {
     "adapter": "WMS",
     "kind": "external",
     "note": "Exactly one WMS command per authorized request; WMS-side stock changes are the WMS's own.",
     "payload": {
      "destination": {
       "input": "destination_warehouse"
      },
      "part": {
       "input": "part"
      },
      "quantity": {
       "input": "quantity"
      },
      "source": {
       "input": "source_warehouse"
      }
     },
     "target": "transfer"
    }
   ],
   "expected_outcome": "WMS commits a transfer record with actual quantity == requested quantity; source available decreases and destination available increases by quantity.",
   "gated_inputs": [
    "source_warehouse",
    "destination_warehouse",
    "part",
    "quantity",
    "work_order"
   ],
   "idempotency": "required",
   "immutable_after_authorization": [
    "source_warehouse",
    "destination_warehouse",
    "part",
    "quantity",
    "work_order"
   ],
   "inputs": [
    {
     "name": "source_warehouse",
     "required": true,
     "resource_type": "Warehouse",
     "type": "resource"
    },
    {
     "name": "destination_warehouse",
     "required": true,
     "resource_type": "Warehouse",
     "type": "resource"
    },
    {
     "name": "part",
     "required": true,
     "resource_type": "Part",
     "type": "resource"
    },
    {
     "name": "quantity",
     "required": true,
     "type": "integer"
    },
    {
     "name": "work_order",
     "required": false,
     "resource_type": "WorkOrder",
     "type": "resource"
    }
   ],
   "name": "transfer_inventory",
   "preconditions": [
    {
     "description": "quantity is an integer (booleans excluded) and >= 1",
     "id": "quantity-positive-int",
     "predicate": {
      "args": [
       {
        "args": [
         {
          "input": "quantity"
         }
        ],
        "op": "is_int"
       },
       {
        "args": [
         {
          "input": "quantity"
         },
         {
          "lit": 1
         }
        ],
        "op": "ge"
       }
      ],
      "op": "and"
     }
    },
    {
     "description": "source_warehouse != destination_warehouse",
     "id": "endpoints-differ",
     "predicate": {
      "args": [
       {
        "input": "source_warehouse"
       },
       {
        "input": "destination_warehouse"
       }
      ],
      "op": "ne"
     }
    },
    {
     "description": "the source lot exists and onHand - reserved >= quantity",
     "id": "source-has-stock",
     "predicate": {
      "args": [
       {
        "args": [
         {
          "unique": {
           "type": "InventoryLot",
           "where": [
            {
             "link": "PartReferencing_part",
             "to": {
              "input": "part"
             }
            },
            {
             "link": "InventoryLot_warehouse",
             "to": {
              "input": "source_warehouse"
             }
            }
           ]
          }
         }
        ],
        "op": "exists"
       },
       {
        "args": [
         {
          "sub": [
           {
            "field": [
             {
              "unique": {
               "type": "InventoryLot",
               "where": [
                {
                 "link": "PartReferencing_part",
                 "to": {
                  "input": "part"
                 }
                },
                {
                 "link": "InventoryLot_warehouse",
                 "to": {
                  "input": "source_warehouse"
                 }
                }
               ]
              }
             },
             "onHand"
            ]
           },
           {
            "field": [
             {
              "unique": {
               "type": "InventoryLot",
               "where": [
                {
                 "link": "PartReferencing_part",
                 "to": {
                  "input": "part"
                 }
                },
                {
                 "link": "InventoryLot_warehouse",
                 "to": {
                  "input": "source_warehouse"
                 }
                }
               ]
              }
             },
             "reserved"
            ]
           }
          ]
         },
         {
          "input": "quantity"
         }
        ],
        "op": "ge"
       }
      ],
      "op": "and"
     }
    }
   ],
   "summary": "Move stock of a part between two warehouses via the external WMS."
  },
  {
   "approval": {
    "approver_operation": "approval:expedite",
    "required_when_rule": "expedite-large-fee-needs-approval",
    "rules": [
