{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Round 3 neutral authority fixture v2 (capability edges, PROT-H24 s1)",
  "type": "object",
  "required": [
    "spec",
    "domain",
    "semantics",
    "principals",
    "grants",
    "delegations",
    "service_accounts",
    "max_delegation_depth",
    "capabilities",
    "revoked"
  ],
  "properties": {
    "spec": {
      "const": "r3-authority-2"
    },
    "domain": {
      "enum": [
        "manufacturing",
        "project"
      ]
    },
    "semantics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "principals": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "roles",
          "relations",
          "delegated_by"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "human",
              "agent"
            ]
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "relations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type",
                "key",
                "relation"
              ]
            }
          },
          "delegated_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "hostile": {
            "type": "boolean"
          }
        }
      }
    },
    "grants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "effect",
          "principal",
          "resource",
          "operation",
          "delegable",
          "origin"
        ],
        "properties": {
          "effect": {
            "enum": [
              "allow",
              "deny"
            ]
          },
          "principal": {
            "type": "object"
          },
          "resource": {
            "type": "object"
          },
          "operation": {
            "type": "string"
          },
          "delegable": {
            "type": "boolean"
          },
          "origin": {
            "enum": [
              "round2",
              "neutral-fix",
              "neutral-extension"
            ]
          }
        }
      }
    },
    "delegations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "agent",
          "on_behalf_of",
          "operations"
        ]
      }
    },
    "service_accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "world_writers",
          "operation_grants"
        ],
        "properties": {
          "kind": {
            "const": "service"
          },
          "operation_grants": {
            "maxItems": 0
          }
        }
      }
    },
    "max_delegation_depth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "revoked": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "issuer",
        "child",
        "parent",
        "scope",
        "expires_at",
        "redelegable",
        "issued_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "issuer": {
          "type": "string"
        },
        "child": {
          "type": "string"
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operations",
            "resources"
          ],
          "properties": {
            "operations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "resources": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "type",
                  "keys"
                ],
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "keys": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "expires_at": {
          "type": [
            "integer",
            "null"
          ]
        },
        "redelegable": {
          "type": "boolean"
        },
        "issued_at": {
          "type": "integer"
        }
      }
    }
  }
}
