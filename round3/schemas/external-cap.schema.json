{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "r3-external-cap-1",
  "title": "Decoded external capability token body (P1f-4); the token text is r3cap1.<base64url(canonical json)>",
  "type": "object",
  "additionalProperties": false,
  "required": ["n", "s", "g"],
  "properties": {
    "n": {"type": "string", "minLength": 1},
    "g": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "s": {
      "type": "array", "minItems": 1,
      "prefixItems": [{"$ref": "#/$defs/root_step"}],
      "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/caveat"}}
    }
  },
  "$defs": {
    "root_step": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [
      {"type": "array", "prefixItems": [{"const": "system"}, {"type": "string", "minLength": 1}], "minItems": 2, "maxItems": 2},
      {"type": "array", "prefixItems": [{"const": "deployment"}, {"type": "string", "minLength": 1}], "minItems": 2, "maxItems": 2}]},
    "caveat": {"oneOf": [
      {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [
        {"enum": ["system", "operation", "target", "payload_digest", "correlation"]}, {"type": "string", "minLength": 1}]},
      {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"const": "max_uses"}, {"type": "integer", "minimum": 1}]},
      {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"const": "not_after_tick"}, {"type": "integer", "minimum": 0}]}]}
  }
}
