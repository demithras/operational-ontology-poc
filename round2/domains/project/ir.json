        "Evidence.payload_hash",
        "Experiment.evaluator_ref",
        "Threshold.value",
        "GOVERNED_BY",
        "MEASURES"
      ],
      "implementation_ref": "src/hdd/verdict.py:evaluate_common",
      "determinism": "deterministic"
    },
