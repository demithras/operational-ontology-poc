  "actions": [
    {
      "id": "create_hypothesis",
      "inputs": [
        {
          "name": "claim",
          "type": "string",
          "required": true
        }
      ],
      "authority_refs": [
        "auth:researcher-create-hypothesis",
        "auth:no-canonical-write-outside-git"
      ],
      "policy_refs": [
        "policy:stale_write_rejected",
        "policy:ephemeral_state_never_canonical"
      ],
      "preconditions": [
        "claim is non-empty"
      ],
      "effects": [
        {
          "target": "Hypothesis",
          "operation": "git_change",
          "fields": [
            "id",
            "claim",
            "phase"
          ]
        }
      ],
      "idempotency": "required",
      "outcome_predicate": "Git contains the hypothesis contract at the expected commit with phase == DRAFT",
      "compensation_action": null,
      "version": "v1"
    },
    {
      "id": "edit_threshold",
      "inputs": [
        {
          "name": "threshold",
          "type": {
            "ref": "Threshold"
          },
          "required": true
        },
        {
          "name": "value",
          "type": "json",
          "required": true
        }
      ],
      "authority_refs": [
        "auth:researcher-edit-threshold",
        "auth:no-canonical-write-outside-git",
        "auth:no-threshold-edit-after-preregistration"
      ],
      "policy_refs": [
        "policy:threshold_edit_after_preregistration_denied",
        "policy:stale_write_rejected"
      ],
      "preconditions": [
        "phase == DRAFT"
      ],
      "effects": [
        {
          "target": "Threshold",
          "operation": "git_change",
          "fields": [
            "value"
          ]
        }
      ],
      "idempotency": "required",
      "outcome_predicate": "Git contains the new threshold value while the hypothesis phase is still DRAFT",
      "compensation_action": null,
      "version": "v1"
    },
    {
      "id": "preregister_hypothesis",
      "inputs": [
        {
          "name": "hypothesis",
          "type": {
            "ref": "Hypothesis"
          },
          "required": true
        },
        {
          "name": "freeze_hash",
          "type": "string",
          "required": true
        }
      ],
      "authority_refs": [
        "auth:researcher-preregister-hypothesis",
        "auth:no-canonical-write-outside-git"
      ],
      "policy_refs": [
        "policy:preregistration_requires_complete_contract",
        "policy:legal_lifecycle_transition_allowed",
        "policy:stale_write_rejected"
      ],
      "preconditions": [
        "phase == DRAFT",
        "freeze_hash exists"
      ],
      "effects": [
        {
          "target": "Hypothesis",
          "operation": "git_change",
          "fields": [
            "phase",
            "freeze_hash"
          ]
        }
      ],
      "idempotency": "required",
      "outcome_predicate": "Git contains preregistered contract at expected commit",
      "compensation_action": null,
      "version": "v1"
    },
    {
      "id": "new_experiment_version",
      "inputs": [
        {
          "name": "experiment",
          "type": {
            "ref": "Experiment"
          },
          "required": true
        },
        {
          "name": "contract_version",
          "type": {
            "ref": "ContractVersion"
          },
          "required": true
        }
      ],
      "authority_refs": [
        "auth:researcher-new-experiment-version",
        "auth:no-canonical-write-outside-git"
      ],
      "policy_refs": [
        "policy:threshold_edit_after_preregistration_denied",
        "policy:historical_binding_preserved",
        "policy:stale_write_rejected"
      ],
      "preconditions": [
        "phase != DRAFT"
      ],
      "effects": [
        {
          "target": "Experiment",
          "operation": "git_change",
          "fields": [
            "id",
            "version",
            "evidence_schema_ref",
            "evaluator_ref"
          ]
        },
        {
          "target": "ContractVersion",
          "operation": "git_change",
          "fields": [
            "id",
            "sha256",
            "git_commit",
            "frozen_at"
          ]
        }
      ],
      "idempotency": "required",
      "outcome_predicate": "Git contains a new Experiment row with a new version and the matching ContractVersion; the old experiment version is unchanged",
      "compensation_action": null,
      "version": "v1"
    },
    {
      "id": "start_run",
      "inputs": [
        {
          "name": "hypothesis",
          "type": {
            "ref": "Hypothesis"
          },
          "required": true
        }
      ],
      "authority_refs": [
        "auth:researcher-start-run",
        "auth:no-canonical-write-outside-git"
      ],
      "policy_refs": [
        "policy:running_requires_freeze_hash",
        "policy:legal_lifecycle_transition_allowed",
        "policy:stale_write_rejected"
      ],
      "preconditions": [
        "phase == PREREGISTERED",
        "freeze_hash exists"
      ],
      "effects": [
        {
          "target": "Hypothesis",
          "operation": "git_change",
          "fields": [
            "phase"
          ]
        }
      ],
      "idempotency": "required",
      "outcome_predicate": "Git contains the hypothesis with phase == RUNNING at the expected commit",
      "compensation_action": null,
      "version": "v1"
    },
    {
      "id": "attach_evidence",
      "inputs": [
        {
          "name": "hypothesis",
          "type": {
            "ref": "Hypothesis"
          },
          "required": true
        },
        {
          "name": "evidence",
          "type": {
