{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eoo.example/schema/paladin-hypothesis-contract.json",
  "title": "Executable Paladin Hypothesis Contract",
  "type": "object",
  "required": [
    "id", "title", "claim", "null_hypothesis", "rivals", "mechanism", "scope",
    "predictions", "falsifiers", "experiment", "oracle", "baseline",
    "required_evidence", "evaluator", "python_hypothesis_role",
    "upstream_dependencies", "stop_conditions"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^H[0-9]+$"},
    "title": {"type": "string", "minLength": 3},
    "claim": {"type": "string", "minLength": 10},
    "null_hypothesis": {"type": "string", "minLength": 10},
    "rivals": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
    "mechanism": {"type": "string", "minLength": 10},
    "scope": {"type": "string", "minLength": 5},
    "predictions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "falsifiers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "experiment": {
      "type": "object",
      "required": ["summary", "steps", "minimum_runs"],
      "properties": {
        "summary": {"type": "string"},
        "steps": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "minimum_runs": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": true
    },
    "oracle": {"type": "string", "minLength": 5},
    "baseline": {"type": "string", "minLength": 5},
    "required_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evaluator": {
      "type": "object",
      "required": ["support_if", "reject_if", "inconclusive_if", "invalid_if"],
      "properties": {
        "support_if": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "reject_if": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "inconclusive_if": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "invalid_if": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "python_hypothesis_role": {
      "type": "object",
      "required": ["level", "strategy", "mutation_proof"],
      "properties": {
        "level": {"enum": ["PRIMARY", "SUPPORTING", "LIMITED", "NONE"]},
        "strategy": {"type": "string"},
        "mutation_proof": {"type": "string"}
      },
      "additionalProperties": false
    },
    "upstream_dependencies": {"type": "array", "items": {"type": "string", "pattern": "^H[0-9]+$"}},
    "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
